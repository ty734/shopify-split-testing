# Copy to .env.local and fill in.

# Postgres (we use Neon). Holds the split.* tables this app owns, plus the
# attribution.* tables it reads (see DATA-CONTRACT.md / schema/attribution-contract.sql).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Dashboard login (a SHA-256 of this becomes the session cookie).
DASHBOARD_PASSWORD=changeme

# Bearer token for programmatic access (scripts, an AI agent, cron). Also salts the
# signed preview links for draft tests, so rotating it invalidates old links.
SPLIT_API_TOKEN=generate-a-long-random-string

# Your storefront, used to build preview links in the dashboard.
STOREFRONT_ORIGIN=https://your-store.example.com

# Optional: Vercel cron auth, if you add cron jobs.
# CRON_SECRET=

# Only for `npm run gate:sync` (pushes the anti-flicker snippet with the Shopify CLI).
# SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_THEME_ID=123456789012
# SPLIT_APP_URL=https://split.your-store.example.com
